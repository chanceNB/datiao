{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datiao.local/contracts/r1_to_r3_event_v0_1.schema.json",
  "title": "R1 to R3 Event Transport V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "session_id",
    "task_segment_id",
    "participant_id",
    "question_id",
    "start_time_ms",
    "end_time_ms",
    "point_refs",
    "stroke_refs",
    "quality_status",
    "algorithm_version",
    "provenance"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["WRITING", "QUESTION_VISIT", "QUESTION_LEAVE", "RETURN", "REVISION_CANDIDATE", "PAGE_CHANGE", "PROCESS_END", "UNKNOWN"]},
    "session_id": {"type": "string", "minLength": 1},
    "task_segment_id": {"type": ["string", "null"]},
    "participant_id": {"type": ["string", "null"]},
    "question_id": {"type": "string", "minLength": 1},
    "start_time_ms": {"type": ["integer", "null"]},
    "end_time_ms": {"type": ["integer", "null"]},
    "point_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "stroke_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "quality_status": {"enum": ["VALID", "DEGRADED", "INVALID"]},
    "algorithm_version": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "properties": {
        "dataset_type": {"type": "string"},
        "generator_version": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "scenario_id": {"type": "string", "minLength": 1},
        "ground_truth_source": {"type": "string", "minLength": 1},
        "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"quality_status": {"const": "VALID"}}, "required": ["quality_status"]},
      "then": {
        "properties": {
          "start_time_ms": {"type": "integer"},
          "end_time_ms": {"type": "integer"}
        }
      }
    },
    {
      "if": {"properties": {"provenance": {"properties": {"dataset_type": {"const": "synthetic"}}}}, "required": ["provenance"]},
      "then": {
        "properties": {
          "provenance": {
            "required": ["dataset_type", "generator_version", "seed", "scenario_id", "ground_truth_source", "manifest_hash"]
          }
        }
      }
    }
  ]
}

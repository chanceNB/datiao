{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datiao.local/contracts/r1_to_r3_event_batch_v0_1.schema.json",
  "title": "R1 to R3 Event Batch Transport V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "batch_id",
    "session_id",
    "task_segment_id",
    "dataset_version",
    "algorithm_version",
    "events"
  ],
  "properties": {
    "contract_version": {"const": "r1-event-batch-v0.1"},
    "batch_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "task_segment_id": {"type": ["string", "null"]},
    "dataset_version": {"type": "string", "minLength": 1},
    "algorithm_version": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "r1_to_r3_event_v0_1.schema.json"}
    }
  }
}
